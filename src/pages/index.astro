---
const features = [
  'Astro project structure',
  'Static landing page',
  'Ready for GitHub Pages, Netlify, or Vercel',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hermes Astro Site Test</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0f172a;
        color: #e2e8f0;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at top left, rgba(56, 189, 248, 0.3), transparent 32rem),
          linear-gradient(135deg, #0f172a, #111827 60%, #1e293b);
      }

      main {
        width: min(92vw, 720px);
        padding: 4rem;
        border: 1px solid rgba(226, 232, 240, 0.18);
        border-radius: 28px;
        background: rgba(15, 23, 42, 0.72);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(18px);
      }

      h1 {
        margin: 0;
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      p {
        max-width: 42rem;
        color: #cbd5e1;
        font-size: 1.15rem;
        line-height: 1.7;
      }

      ul {
        display: grid;
        gap: 0.75rem;
        padding: 0;
        list-style: none;
      }

      li {
        padding: 0.9rem 1rem;
        border-radius: 14px;
        background: rgba(148, 163, 184, 0.12);
      }

      a {
        color: #7dd3fc;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Hello from Astro.</h1>
      <p>
        This small site was created locally, committed to git, published as a public GitHub repository, and verified with an Astro production build.
      </p>
      <ul>
        {features.map((feature) => <li>{feature}</li>)}
      </ul>
      <p>
        Edit <code>src/pages/index.astro</code> to customize it.
      </p>
    </main>
  </body>
</html>
